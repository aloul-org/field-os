# FieldOS mobile — PUBLIC config only.
# Copy to `.env` and fill in. These mirror the NEXT_PUBLIC_* values from the web
# app's .env.local — both clients point at the SAME Supabase project, so an
# account works on web and mobile interchangeably.
#
# RLS is the security boundary. NEVER put secret keys (Anthropic, OpenAI,
# Stripe, Twilio, service-role) in this file — anything bundled into the app can
# be extracted from the shipped APK/IPA. Those stay server-side behind the
# Next.js API, which mobile calls with the user's Supabase JWT.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Next.js app, for the AI endpoints (estimate extraction, coach, copilot).
# Android emulator: use http://10.0.2.2:3000 to reach the host's localhost.
# iOS simulator:    http://localhost:3000
# Production:       https://your-app-domain.com
API_BASE_URL=http://10.0.2.2:3000
